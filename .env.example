# Environment Variables for Federation Gateway
#
# This one root .env is read by two different tools for two different
# purposes: `docker compose up` reads the "Docker Compose secrets" section
# below for variable substitution in docker-compose.yml; Vite reads the
# VITE_* section for frontend builds run outside Docker. Copy this file to
# `.env` (gitignored) and fill in real values, or generate one automatically:
#
#   python3 scripts/generate-secrets.py
#
# ── Docker Compose secrets (required — docker-compose.yml fails closed if
#    any of these are unset; see PRODUCTION-READINESS.md #5) ──────────────

# HTTP Basic Auth credentials the backend uses to reach LightHouse's admin
# API (see backend/config/gateway.yaml, PRODUCTION-READINESS.md #3 for why
# these are now genuinely load-bearing). ta-1/ta-2 and the mesh-* instances
# share this pair; mesh2-* uses the separate pair below.
LIGHTHOUSE_ADMIN_USERNAME=gateway
LIGHTHOUSE_ADMIN_PASSWORD=change-me

# Distinct credentials for the mesh2-* federation (deliberately separate —
# a real independent federation would never share admin credentials with
# this one).
LIGHTHOUSE2_ADMIN_USERNAME=gateway2
LIGHTHOUSE2_ADMIN_PASSWORD=change-me

# Fernet key encrypting stored OIDC provider client secrets at rest
# (backend/app/auth/crypto.py). Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OIDC_ENCRYPTION_KEY=change-me

# Signs every gateway-issued JWT (access/refresh tokens, OIDC login state).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Password for the seeded admin@oidfed.org account — the only path to
# super_admin on a fresh database (backend/app/db/seed.py). Left as the
# well-known "admin123" here deliberately, unlike the vars above: it's a
# human-typed login credential, not a machine-to-machine secret, and the
# demo/tests rely on it staying predictable. scripts/generate-secrets.py
# does NOT randomize this one for that reason. CHANGE THIS before any real
# deployment — there's no forced-rotation or disable-after-bootstrap flow
# yet (PRODUCTION-READINESS.md #2), so a real deployment stopping here is
# still shipping a known password unless you edit it by hand.
ADMIN_BOOTSTRAP_PASSWORD=admin123

# ── Frontend build-time config (Vite; only needed when running the UI
#    outside Docker — see docs/LOCAL-DEVELOPMENT.md) ───────────────────────

# API Base URL
# Point this to your OpenID Federation Admin API backend
# Default: http://localhost:8765 (reference FastAPI backend)
# Production: Set to your backend URL
VITE_API_BASE_URL=http://localhost:8765

# Examples for different deployment scenarios:
# VITE_API_BASE_URL=https://api.federation.example.org
# VITE_API_BASE_URL=https://oidfed-backend.cloud.edu/v1
# VITE_API_BASE_URL=http://localhost:9000  # Custom port

# Optional: Multi-backend switcher configuration (JSON array)
# If provided, UI lets operators switch backend pods/instances at runtime.
# Example:
# VITE_BACKENDS_JSON=[{"id":"pod-a","name":"Admin API A","baseUrl":"http://localhost:8765"},{"id":"pod-b","name":"Admin API B","baseUrl":"http://localhost:9865"}]
