# Copy to backend/.env for local (non-Docker) backend development.
# Not read automatically — export these yourself or use `docker compose up`,
# which sets its own env vars directly in docker-compose.yml.

DATABASE_URL=sqlite:///./backend.db

# Must be a real random secret for anything beyond localhost — the code
# falls back to a hardcoded, publicly-known default if this is unset.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
